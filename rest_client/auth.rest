### Configurações de Variáveis
@baseUrl = http://localhost:3000/api/auth
@contentType = application/json

############################################################
# 1. REGISTRO DE NOVO USUÁRIO
############################################################
# @name register
POST {{baseUrl}}/signup
Content-Type: {{contentType}}

{
  "name": "Paulo Robson",
  "email": "paulo.robson@example.com",
  "password": "senha_segura_123"
}

###

############################################################
# 2. LOGIN (OBTER TOKEN/COOKIE)
############################################################
# @name login
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "paulo.robson@example.com",
  "password": "senha_segura_123"
}

###

############################################################
# 3. VERIFICAR SESSÃO (ME)
# Requer o Cookie ou o Bearer Token retornado no Login
############################################################
# @name getMe
GET {{baseUrl}}/me
Content-Type: {{contentType}}
# Authorization: Bearer {{login.response.body.token}}

###

############################################################
# 4. HEALTH CHECK (OPCIONAL)
############################################################
GET http://localhost:3333/api/health